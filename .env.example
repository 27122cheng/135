# ─────────────────────────────────────────────────────────────────
# 這個專案預設「零金鑰可跑」。以下除了 ANTHROPIC_API_KEY 之外全部是
# 選用的升級選項 —— 每個面向都已經有免金鑰的公開來源在供應資料。
# ─────────────────────────────────────────────────────────────────

# ── 唯一無法用免費 API 取代的 ────────────────────────────────────
# 沒有這把金鑰，AI 綜合敘述與 AI 交易計畫會改用本地預設規則
# （卡片右上角會顯示「預設規則」而非「AI 判斷」）。
# https://console.anthropic.com
ANTHROPIC_API_KEY=
# 選用：模型覆寫，未設定時預設 claude-sonnet-4-5
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── 以下皆為選用（不設定也能跑）──────────────────────────────────

# OHLCV 主要來源。未設定時改用 yfinance（Yahoo chart 端點）→ Stooq CSV，
# 兩者皆免金鑰。設定後可避免 Yahoo 對雲端機房 IP 的限流。
# https://twelvedata.com （免費 800 次/日）
TWELVE_DATA_API_KEY=

# 總經資料。未設定時改用 FRED 的免金鑰 CSV 端點 (fredgraph.csv)，
# 資料完全相同。設定後走官方 JSON API。
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 新聞與財報日曆。未設定時新聞由 GDELT（免金鑰）供應；
# 財報日曆會缺席，但它只產生權重 0 的參考項目，不影響計分。
# https://finnhub.io
FINNHUB_API_KEY=

# WTI 原油庫存。未設定時改用 FRED 的 WCESTUS1（即 EIA 原始資料）。
# https://www.eia.gov/opendata/
EIA_API_KEY=

# ── 歷史訊號與排程（選用，只影響 /history 與 cron）──────────────
# 先套用 supabase/schema.sql 再填。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 僅供伺服器端使用，用來繞過 RLS 寫入。切勿外流到前端。
SUPABASE_SERVICE_ROLE_KEY=
# 選用：設定後 /api/cron/refresh-signals 會要求 Authorization: Bearer <值>
CRON_SECRET=

# 免金鑰、完全不需設定的來源：
#   GDELT 2.0（新聞）、CFTC Socrata（COT 籌碼）、
#   Yahoo chart + Stooq（OHLCV 備援）、FRED CSV（總經）、SPDR GLD（持倉）
