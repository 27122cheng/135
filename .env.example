# ── OHLCV (primary) ─────────────────────────────────────────────
# Twelve Data — free tier: 800 requests/day. https://twelvedata.com
TWELVE_DATA_API_KEY=

# ── Macro (FRED) ────────────────────────────────────────────────
# FRED — free, instant key. https://fred.stlouisfed.org/docs/api/api_key.html
# Powers DXY(DTWEXBGS)/DGS10/DGS02(DGS2)/T10YIE/VIX(VIXCLS).
FRED_API_KEY=

# ── Economic calendar + news + earnings (Stage 2) ───────────────
# Finnhub — free tier. https://finnhub.io
FINNHUB_API_KEY=

# ── WTI crude inventory (Stage 2 addition — see README) ─────────
# EIA Open Data — free, instant key. https://www.eia.gov/opendata/
EIA_API_KEY=

# ── AI (news sentiment scoring + AI綜合 narrative synthesis) ────
# Anthropic API key. https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model override, defaults to claude-sonnet-4-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Database + cron persistence (Stage 2) ────────────────────────
# Supabase project. Apply supabase/schema.sql once before first cron run.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — used by /api/cron/refresh-signals to write past RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: if set, /api/cron/refresh-signals requires `Authorization: Bearer <CRON_SECRET>`.
# Vercel Cron sends this automatically when the env var is set on the project.
CRON_SECRET=

# No keys are required to run the app: every fetcher fails gracefully
# and records the reason to `data_gaps` instead of fabricating data.
# GDELT 2.0 and CFTC's public Socrata COT dataset need no key at all.
