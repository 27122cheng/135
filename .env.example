# ─────────────────────────────────────────────────────────────────
# 全免費版本：這裡沒有任何一項需要付費，而且「零金鑰也能跑」。
# 每個面向都有免金鑰的公開來源在供應資料，AI 環節則有本地規則備援。
#
# 這些也可以不設環境變數，直接開網站的 /settings 頁面貼上，立即生效。
# ─────────────────────────────────────────────────────────────────

# ── AI 分析層（免費，建議設定）────────────────────────────────────
# 順序：Gemini → Groq → OpenRouter → Anthropic。
# 前一個沒金鑰就跳過，額度用盡或失敗就換下一個。
# 三個都不設也能跑，但新聞情緒與交易計畫會退成本地關鍵字／預設規則。

# 主用。免費 1500 次/日、1M context，不需信用卡。
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 選用：未設定時預設 gemini-2.5-flash
GEMINI_MODEL=

# 備援。免費 30 次/分，速度很快。
# https://console.groq.com/keys
GROQ_API_KEY=
# 選用：未設定時預設 llama-3.3-70b-versatile
GROQ_MODEL=

# 第二備援，走 :free 模型。前兩個都掛掉才會用到。
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# 選用：未設定時預設 meta-llama/llama-3.3-70b-instruct:free
# 免費模型會不定期下架，掛了就換一個：https://openrouter.ai/models?q=free
OPENROUTER_MODEL=

# 選用：覆寫供應商順序，逗號分隔。例如只想用 Groq 就填 groq
AI_PROVIDER_ORDER=

# 唯一的付費選項，排在最後。上面任一個能用就永遠不會走到這裡。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── 行情資料（不需金鑰）──────────────────────────────────────────
# 主來源是自架的 yfinance 代理（/api/proxy/ohlcv），備援 Stooq CSV，
# 兩者都免金鑰。時間框架只做 H4 / D1 / W1，資料為 EOD 或延遲 15 分鐘。
# Twelve Data（免費版只開 3 個市場）與 Alpha Vantage（剩 25 次/日）都已移除。

# ── 總經 / 新聞 / 籌碼（本來就免費）─────────────────────────────
# FRED、CFTC Socrata、GDELT 2.0、EIA 庫存都走免金鑰端點，以下純屬選用。

# 總經。未設定時用 FRED 免金鑰 CSV 端點 (fredgraph.csv)，資料完全相同。
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 額外新聞來源＋美股財報日曆。新聞已由 GDELT 免金鑰供應。
# https://finnhub.io
FINNHUB_API_KEY=

# WTI 原油庫存。未設定時用 FRED 的 WCESTUS1（即同一份 EIA 資料）。
# https://www.eia.gov/opendata/
EIA_API_KEY=

# ── 資料庫（選用，只影響 /history 與排程寫入）────────────────────
# 二選一，先套用 supabase/schema.sql（純 SQL，兩邊都適用）。

# 方式 A：任何 Postgres，包含 Neon 免費方案。設了就以這個為準。
# https://neon.tech
DATABASE_URL=

# 方式 B：Supabase 免費層（DATABASE_URL 沒設時才會用）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 僅供伺服器端使用，用來繞過 RLS 寫入。切勿外流到前端。
SUPABASE_SERVICE_ROLE_KEY=

# ── 排程（GitHub Actions，不是 Vercel Cron）──────────────────────
# Vercel Hobby 的 cron 一天只能跑一次，所以排程搬到
# .github/workflows/refresh.yml（每 4 小時）。
# 在 GitHub repo 的 Settings → Secrets 加上 APP_URL 與 CRON_SECRET，
# 這裡也要填一樣的 CRON_SECRET，/api/refresh 才會接受該請求。
CRON_SECRET=

# 完全不需設定的免金鑰來源：
#   yfinance 代理（Yahoo chart）、Stooq CSV、GDELT 2.0、
#   CFTC Socrata（COT 籌碼）、FRED CSV、SPDR GLD 持倉
